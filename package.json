{
  "name": "kurobara.systems",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "build": "vite build && node scripts/localize-build.mjs",
    "check": "biome check --no-errors-on-unmatched",
    "dev": "vite --host 127.0.0.1",
    "fix": "biome check --write --no-errors-on-unmatched",
    "preview": "vite preview --host 127.0.0.1",
    "security:audit": "npm audit --omit=dev --package-lock-only --audit-level=info",
    "security:audit:all": "npm audit --package-lock-only --audit-level=info",
    "test": "node --test test/*.test.mjs",
    "test:server": "node scripts/smoke-server.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "preview:export": "npm run build && node scripts/export-preview.mjs"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "24.13.4",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  }
}
