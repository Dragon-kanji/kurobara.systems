# Runtime-only security patch; keep the deployed HTML byte-for-byte.
# Verify DEPLOYED_IMAGE resolves to the recorded immutable image ID before build.
ARG DEPLOYED_IMAGE=s11ycr1hgw07n6tbdyx713v7:7afb9f90142d6e8bdbcf5bdae571d02479643ae6
FROM ${DEPLOYED_IMAGE} AS deployed
FROM nginxinc/nginx-unprivileged:1.30.6-alpine@sha256:f5116ed4606f3eb015dd4a8e28cb9b351476dc0ad4bc6e9f93b19cec130cdf03
ENV CONTACT_HUB_PROXY_TOKEN=""
COPY --from=deployed /etc/nginx/security-headers.conf /etc/nginx/security-headers.conf
COPY --from=deployed /etc/nginx/templates/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=deployed /usr/share/nginx/html/ /usr/share/nginx/html/
USER 101
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --spider http://127.0.0.1:8080/healthz || exit 1
